# TRINETRA AI Surveillance Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False

# PostgreSQL Database Configuration (Primary as per README Tech Stack)
# If PostgreSQL is not running locally, TRINETRA automatically falls back
# to high-performance SQLite WAL persistence at backend/trinetra.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trinetra_db

# Or override directly with a full connection URI: 
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trinetra_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# AI & Computer Vision Configuration
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
LOITERING_DISTANCE=60.0
LOITERING_TIME=8.0

# Camera Stream Configuration
CAMERA_SOURCE=0
STREAM_FPS=25
FRAME_WIDTH=640
FRAME_HEIGHT=360
